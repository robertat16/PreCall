{
  "name": "precall",
  "version": "1.0.0",
  "description": "PreCall - mic, speaker and camera test before your call",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "sync": "npm run build && npx cap sync android",
    "icons": "node scripts/make-icons.mjs",
    "store:shots": "python3 scripts/fixtures/make-person-y4m.py && npm run build && playwright test -c playwright.store.config.ts && node scripts/compose-store-shots.mjs"
  },
  "author": "PreCall",
  "license": "UNLICENSED",
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/splash-screen": "^8.0.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
